<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- The ICCOA SDK renders the phone's Miracast stream straight into this surface. -->
    <SurfaceView
        android:id="@+id/icoca_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/icoca_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/da_connecting"
        android:textColor="#CCFFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- No permanent on-screen disconnect button: the phone-side CarLink UI already has
         "return to head unit" (退出投屏), and the activity finishes itself when the session
         drops. A permanent overlay would sit on top of the mirrored UI and block the phone's
         own top-right controls. -->

</FrameLayout>
